# Spotify API Credentials
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://your-app.onrender.com/callback
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Set to "true" for production HTTPS (default), "false" only for local HTTP development
COOKIE_SECURE=true

# Log level for the app's own diagnostic loggers (deezer/spotify matching,
# token refresh, request tracing). Default INFO; set to DEBUG when
# investigating an issue locally.
LOG_LEVEL=INFO